# ---------------------------------------------------------------------------
# Vendix — variáveis de ambiente (exemplo). Copie para `.env`.
# NUNCA versione `.env` com valores reais.
# ---------------------------------------------------------------------------

# PostgreSQL (Neon recomenda sslmode=require e pgbouncer para serverless)
DATABASE_URL="postgresql://usuario:senha@host:5432/vendix?sslmode=require"

# Segredo do NextAuth (openssl rand -base64 32)
AUTH_SECRET=""

# URL pública (local: http://localhost:3000)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Chave de 32 bytes (base64) para cifrar credenciais de integração no banco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY=""

# Seed — superadministrador da plataforma
SEED_PLATFORM_ADMIN_EMAIL="admin@vendix.com.br"
SEED_PLATFORM_ADMIN_PASSWORD=""

# Seed — empresa de demonstração (dados fictícios claramente identificados)
SEED_DEMO_EMAIL="demo@vendix.com.br"
SEED_DEMO_PASSWORD=""

# E-mail transacional (recuperação de senha). Sem provedor, o link não é enviado.
RESEND_API_KEY=""
EMAIL_FROM="Vendix <nao-responda@seudominio.com.br>"
# Apenas desenvolvimento: exibe o link de redefinição na tela. Nunca em produção.
PASSWORD_RESET_DEV_LINK="false"

# WhatsApp Cloud API (opcional). Sem estas variáveis o envio automático fica desabilitado.
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# Banco descartável para testes de integração/isolamento (NUNCA produção).
TEST_DATABASE_URL=""
